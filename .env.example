# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Application & Security
PORT="3000"
JWT_SECRET="replace-with-a-secure-random-jwt-secret-key-min-32-chars"
ADMIN_EMAIL="prashant37chaturvedi@gmail.com"
ADMIN_SECRET_KEY="replace-with-secure-admin-secret-key"

# Database Configuration (Production-grade persistent SQLite database)
DATABASE_PATH="./data/health_on_click.sqlite"

# Medical Drive Storage (Server-side cloud-grade secure file storage)
STORAGE_DIR="./uploads/medical_drive"

# Email Delivery Configuration (Nodemailer / SMTP)
# Used for doctor verification alerts, approval/rejection emails, appointment confirmations
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="notifications@healthonclick.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Health On Click <notifications@healthonclick.com>"

# SMS / OTP Provider (Twilio or compatible HTTP SMS Gateway)
# Used for real-time mobile OTP dispatch
SMS_PROVIDER="twilio" # options: twilio, log_dispatch
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+15551234567"

# Google Authentication (OAuth 2.0)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Emergency Services Configuration
EMERGENCY_PHONE_NUMBER="112"

